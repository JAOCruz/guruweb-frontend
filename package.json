{
  "name": "guruweb-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:landing": "npm run build -w apps/landing",
    "build:dashboard": "npm run build -w apps/dashboard",
    "dev:landing": "npm run dev -w apps/landing",
    "dev:dashboard": "npm run dev -w apps/dashboard",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^7.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
